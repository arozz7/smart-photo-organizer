{
  "name": "smart-photo-organizer",
  "private": true,
  "version": "0.7.5",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dev": "vite",
    "build:python": "node scripts/build-python.js",
    "build:runtime": "node scripts/build-runtime.js",
    "build": "npm run build:python && tsc && vite build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "preview": "vite preview",
    "pretest": "node -e \"const {execFileSync}=require('child_process'),p=require('path');execFileSync(p.join('node_modules','.bin',process.platform==='win32'?'node-gyp.cmd':'node-gyp'),['rebuild'],{cwd:p.join('node_modules','better-sqlite3'),stdio:'inherit'})\"",
    "test": "vitest run",
    "posttest": "node_modules/.bin/electron-rebuild -f -w better-sqlite3",
    "test:fix": "node_modules/.bin/electron-rebuild -f -w better-sqlite3 && vitest run",
    "test:watch": "vitest",
    "test:backend": "vitest run --include 'tests/backend/**/*.test.ts'",
    "test:frontend": "vitest run --include 'tests/frontend/**/*.test.{ts,tsx}'",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "@vladmandic/human": "^3.3.6",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "11.3.0",
    "electron-store": "^11.0.2",
    "exiftool-vendored": "^34.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.10.1",
    "react-virtuoso": "^4.17.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/react-virtualized-auto-sizer": "^1.0.8",
    "@types/react-window": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.22",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.0.16"
  },
  "main": "dist-electron/main.js"
}
